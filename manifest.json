{
    "manifest_version": 3,
    "name": "MindfulGate 清醒门神",
    "version": "1.3",
    "description": "意图门神 + 正念呼吸：对抗算法沉迷",
    "permissions": [
      "storage"
    ],
    "icons": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "action": {
      "default_icon": "icon.png",
      "default_title": "MindfulGate 清醒门神"
    },
    "content_scripts": [
      {
        "matches": [
          "*://*.xiaohongshu.com/*",
          "*://*.douyin.com/*",
          "*://*.bilibili.com/*",
          "*://*.kuaishou.com/*",
          "*://*.tiktok.com/*",
          "*://*.instagram.com/*",
          "*://*.x.com/*",
          "*://*.twitter.com/*",
          "*://*.youtube.com/*",
          "*://*.threads.net/*",
          "*://*.threads.com/*"
        ],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }